      "item": [
        {
          "name": "01 Order health",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{orderBaseUrl}}/actuator/health"
          }
        },
        {
          "name": "02 Payment health",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{paymentBaseUrl}}/actuator/health"
          }
        },
        {
          "name": "03 Create order - requires valid product and enabled PayOS",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) { const d = pm.response.json().data; pm.collectionVariables.set(\"orderId\",d.id); pm.collectionVariables.set(\"orderCode\",String(d.orderCode)); pm.collectionVariables.set(\"paymentId\",d.paymentId); pm.collectionVariables.set(\"checkoutUrl\",d.checkoutUrl); }"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "method": "POST",
            "body": {
              "raw": "{\"userId\":\"{{userId}}\",\"buyerName\":\"Postman Tester\",\"buyerEmail\":\"tester@example.com\",\"items\":[{\"productId\":\"{{productId}}\",\"quantity\":1}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw"
            },
            "url": "{{orderBaseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "04 Get order by ID",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "05 Get order by code",
