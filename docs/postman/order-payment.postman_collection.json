              }
            ],
            "method": "POST",
            "body": {
              "raw": "{\"reason\":\"Postman test cancellation\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw"
            },
            "url": "{{orderBaseUrl}}/api/v1/orders/{{orderId}}/cancel"
          }
        }
