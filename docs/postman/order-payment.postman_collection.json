            }
          ],
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{orderBaseUrl}}/api/v1/orders/code/{{orderCode}}"
          }
        },
        {
          "name": "06 Get payment by order ID",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code < 300) { const d = pm.response.json().data; pm.collectionVariables.set(\"paymentId\",d.id); }"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{paymentBaseUrl}}/api/payments/order/{{orderId}}"
          }
        },
        {
          "name": "07 Get payment by ID",
          "event": [
            {
              "script": {
