      "name": "Order to Payment flow"
    },
    {
      "item": [
        {
          "name": "01 Create payment independently - enabled PayOS required",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) { const d = pm.response.json().data; pm.collectionVariables.set(\"standalonePaymentId\",d.id); pm.collectionVariables.set(\"standaloneCheckoutUrl\",d.checkoutUrl); }"
                ]
              },
              "listen": "test"
            },
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"standaloneOrderId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"standaloneOrderCode\", String(Date.now()));"
                ]
              },
              "listen": "prerequest"
            }
          ],
          "request": {
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "method": "POST",
            "body": {
              "raw": "{\"orderId\":\"{{standaloneOrderId}}\",\"orderCode\":{{standaloneOrderCode}},\"userId\":\"{{userId}}\",\"buyerName\":\"Postman Tester\",\"buyerEmail\":\"tester@example.com\",\"amount\":10000,\"currency\":\"VND\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw"
            },
            "url": "{{paymentBaseUrl}}/api/payments/payos/create"
          }
        },
        {
          "name": "02 Get standalone payment",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{paymentBaseUrl}}/api/payments/{{standalonePaymentId}}"
          }
        },
        {
          "name": "03 Cancel standalone payment",
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              },
              "listen": "test"
            }
          ],
          "request": {
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "method": "POST",
            "body": {
              "raw": "{\"reason\":\"Postman test cancellation\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw"
            },
            "url": "{{paymentBaseUrl}}/api/payments/payos/{{standaloneOrderCode}}/cancel"
          }
        }
      ],
      "name": "Standalone Payment"
